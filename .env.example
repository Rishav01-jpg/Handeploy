# Application
NODE_ENV=development
APP_NAME=Handeploy
APP_VERSION=0.1.0

# API
API_HOST=0.0.0.0
API_PORT=4000

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=handeploy

# Redis
REDIS_URL=

# Authentication
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=

# Logging
LOG_LEVEL=info

# AWS
AWS_REGION=
AWS_ACCOUNT_ID=

# Container Registry
ECR_REGISTRY=

# Kubernetes
KUBERNETES_NAMESPACE=

# Deployment
PORT_RANGE_START=1000
PORT_RANGE_END=9999
